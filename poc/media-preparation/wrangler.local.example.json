{
  "name": "avocado-media-poc-local",
  "main": "worker-entrypoint.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "containers": [{
    "class_name": "MediaContainer",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile", "build_context": "." } }
  }],
  "durable_objects": { "bindings": [{ "name": "CONTAINERS", "class_name": "MediaContainer" }] },
  "exports": { "MediaContainer": { "type": "durable-object", "storage": "sqlite" } },
  "dev": { "ip": "127.0.0.1", "port": 8788, "local_protocol": "http" }
}
