{
  "name": "avocado",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run sdk:build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json && tsc -p sdk/tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply avocado-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply avocado-db --remote",
    "seed:local": "node scripts/seed.ts",
    "lint:design": "node scripts/lint-design.ts",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:test": "npm --prefix sdk run test",
    "sdk:size": "npm --prefix sdk run size"
  },
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
